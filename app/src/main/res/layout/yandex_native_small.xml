<?xml version="1.0" encoding="utf-8"?>
<com.yandex.mobile.ads.nativeads.NativeAdView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/gnt_outline_shape"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.yandex.mobile.ads.nativeads.MediaView
                android:id="@+id/yandex_native_media"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp" />

            <ImageView
                android:id="@+id/yandex_native_icon"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                tools:src="@android:drawable/sym_def_app_icon" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/yandex_native_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:textColor="@color/gnt_gray"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="Headline" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/yandex_native_sponsored"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/gnt_rounded_corners_shape"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:paddingStart="4dp"
                        android:paddingTop="1dp"
                        android:paddingEnd="4dp"
                        android:paddingBottom="1dp"
                        android:textColor="@color/gnt_ad_green"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        tools:text="Ad" />

                    <TextView
                        android:id="@+id/yandex_native_body"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:textColor="@color/gnt_gray"
                        android:textSize="11sp"
                        tools:text="Description stays on one line" />
                </LinearLayout>
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/yandex_native_cta"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/ic_round_button"
                android:backgroundTint="@color/gnt_blue"
                android:ellipsize="end"
                android:minWidth="72dp"
                android:minHeight="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:singleLine="true"
                android:textAllCaps="false"
                android:textColor="@color/gnt_white"
                android:textSize="12sp"
                tools:text="Install" />
        </LinearLayout>

        <TextView
            android:id="@+id/yandex_native_domain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/gnt_gray"
            android:textSize="9sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/yandex_native_warning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/gnt_gray"
            android:textSize="8sp" />
    </LinearLayout>
</com.yandex.mobile.ads.nativeads.NativeAdView>
